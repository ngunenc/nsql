#!/usr/bin/env php
<?php

/**
 * NSQL CLI Tool
 * 
 * Migration ve seed işlemleri için komut satırı aracı
 */

(static function (): void {
    $candidates = [
        $GLOBALS['_composer_autoload_path'] ?? null,
        __DIR__ . '/../vendor/autoload.php',
        __DIR__ . '/../../../autoload.php',
    ];
    foreach ($candidates as $autoload) {
        if (is_string($autoload) && is_file($autoload)) {
            require_once $autoload;

            return;
        }
    }
    fwrite(STDERR, "HATA: Composer autoload dosyası bulunamadı. Önce 'composer install' çalıştırın.\n");
    exit(1);
})();

use nsql\database\Config;
use nsql\database\Nsql;
use nsql\database\MigrationManager;
use nsql\database\schema\Schema;
use nsql\database\schema\SchemaValidator;

class nsql_cli
{
    private ?MigrationManager $migration_manager = null;
    private ?string $migrations_path = null;
    private ?string $seeds_path = null;
    private ?string $schema_path = null;
    private bool $strict = false;
    private bool $json = false;

    private function manager(): MigrationManager
    {
        return $this->migration_manager ??= new MigrationManager(new Nsql(), $this->migrations_path, $this->seeds_path);
    }

    public function run(array $argv): void
    {
        $args = [];
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--path=')) {
                $this->migrations_path = substr($arg, strlen('--path='));
            } elseif (str_starts_with($arg, '--seeds-path=')) {
                $this->seeds_path = substr($arg, strlen('--seeds-path='));
            } elseif (str_starts_with($arg, '--schema=')) {
                $this->schema_path = substr($arg, strlen('--schema='));
            } elseif ($arg === '--strict') {
                $this->strict = true;
            } elseif ($arg === '--json') {
                $this->json = true;
            } else {
                $args[] = $arg;
            }
        }

        if (empty($args) || ! isset($args[1])) {
            $this->show_help();
            return;
        }

        $command = $args[1];

        match ($command) {
            'migrate' => $this->migrate(),
            'migrate:rollback' => $this->rollback(),
            'migrate:status' => $this->migrate_status(),
            'migrate:create' => $this->migrate_create($args[2] ?? null),
            'seed' => $this->seed($args[2] ?? null),
            'seed:create' => $this->seed_create($args[2] ?? null),
            'db:status' => $this->db_status(),
            'schema:check' => $this->schema_check(),
            'help', '--help', '-h' => $this->show_help(),
            default => $this->error("Bilinmeyen komut: {$command}"),
        };
    }

    private function migrate(): void
    {
        echo "Migration'lar çalıştırılıyor...\n";
        try {
            $executed = $this->manager()->migrate();
            if (empty($executed)) {
                echo "Çalıştırılacak migration yok.\n";
            } else {
                echo "Başarıyla çalıştırılan migration'lar:\n";
                foreach ($executed as $migration) {
                    echo "  - {$migration}\n";
                }
            }
        } catch (\Exception $e) {
            $this->error("Migration hatası: " . $e->getMessage());
        }
    }

    private function rollback(): void
    {
        echo "Son batch rollback ediliyor...\n";
        try {
            $rolled_back = $this->manager()->rollback();
            if (empty($rolled_back)) {
                echo "Rollback edilecek migration yok.\n";
            } else {
                echo "Başarıyla rollback edilen migration'lar:\n";
                foreach ($rolled_back as $migration) {
                    echo "  - {$migration}\n";
                }
            }
        } catch (\Exception $e) {
            $this->error("Rollback hatası: " . $e->getMessage());
        }
    }

    private function migrate_status(): void
    {
        echo "Migration durumu:\n\n";
        try {
            $report = $this->manager()->get_status_report();
            echo "Toplam Migration: {$report['total_migrations']}\n";
            echo "Uygulanan: {$report['applied_count']}\n";
            echo "Bekleyen: {$report['pending_count']}\n";
            echo "Son Batch: {$report['last_batch']}\n\n";
            
            if (! empty($report['pending_migrations'])) {
                echo "Bekleyen migration'lar:\n";
                foreach ($report['pending_migrations'] as $migration) {
                    echo "  - {$migration}\n";
                }
            }
        } catch (\Exception $e) {
            $this->error("Status hatası: " . $e->getMessage());
        }
    }

    private function migrate_create(?string $name): void
    {
        if (empty($name)) {
            $this->error("Migration adı belirtilmedi. Kullanım: vendor/bin/nsql migrate:create migration_name");
            return;
        }

        try {
            $path = $this->manager()->create($name);
            echo "Migration oluşturuldu: {$path}\n";
        } catch (\Exception $e) {
            $this->error("Migration oluşturma hatası: " . $e->getMessage());
        }
    }

    private function seed(?string $class): void
    {
        echo "Seed verileri yükleniyor...\n";
        try {
            $this->manager()->seed($class);
            echo "Seed işlemi tamamlandı.\n";
        } catch (\Exception $e) {
            $this->error("Seed hatası: " . $e->getMessage());
        }
    }

    private function seed_create(?string $name): void
    {
        if (empty($name)) {
            $this->error("Seeder adı belirtilmedi. Kullanım: vendor/bin/nsql seed:create seeder_name");
            return;
        }

        try {
            $path = $this->manager()->create_seeder($name);
            echo "Seeder oluşturuldu: {$path}\n";
        } catch (\Exception $e) {
            $this->error("Seeder oluşturma hatası: " . $e->getMessage());
        }
    }

    private function db_status(): void
    {
        echo "Veritabanı durumu:\n\n";
        try {
            $db = new Nsql();
            $stats = $db->get_all_stats();
            
            echo "Cache:\n";
            $cache = $stats['cache'] ?? [];
            echo "  Enabled: " . ($cache['enabled'] ?? false ? 'Yes' : 'No') . "\n";
            echo "  Hit Rate: " . ($cache['hit_rate'] ?? 0) . "%\n";
            echo "  Size: " . ($cache['size'] ?? 0) . "/" . ($cache['limit'] ?? 0) . "\n\n";
            
            echo "Memory:\n";
            $memory = $stats['memory'] ?? [];
            echo "  Current: " . $this->format_bytes($memory['current_usage'] ?? 0) . "\n";
            echo "  Peak: " . $this->format_bytes($memory['peak_usage'] ?? 0) . "\n\n";
            
            echo "Connection Pool:\n";
            $pool = $stats['connection_pool'] ?? [];
            echo "  Active: " . ($pool['active_connections'] ?? 0) . "\n";
            echo "  Total: " . ($pool['total_connections'] ?? 0) . "\n";
        } catch (\Exception $e) {
            $this->error("Status hatası: " . $e->getMessage());
        }
    }

    private function schema_check(): void
    {
        $path = $this->schema_path;
        if ($path === null || trim($path) === '') {
            $configured = Config::get('schema_path');
            $path = is_string($configured) && trim($configured) !== '' ? $configured : 'database/schema.php';
        }
        if (! preg_match('/^([A-Za-z]:)?[\/\\\\]/', $path)) {
            $path = rtrim(Config::get_project_root(), '/\\') . DIRECTORY_SEPARATOR . $path;
        }

        try {
            $report = (new SchemaValidator(new Nsql(), $this->strict))->validate(Schema::from_file($path));
        } catch (\Throwable $e) {
            $this->error("Şema kontrolü hatası: " . $e->getMessage());
            return;
        }

        echo $this->json
            ? json_encode($report->to_array(), JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n"
            : $report->format() . "\n";

        if (! $report->is_valid()) {
            exit(1);
        }
    }

    private function format_bytes(int $bytes): string
    {
        $units = ['B', 'KB', 'MB', 'GB'];
        $i = 0;
        while ($bytes >= 1024 && $i < count($units) - 1) {
            $bytes /= 1024;
            $i++;
        }
        return round($bytes, 2) . ' ' . $units[$i];
    }

    private function show_help(): void
    {
        echo "NSQL CLI Tool\n\n";
        echo "Kullanım: vendor/bin/nsql <komut> [argümanlar]\n\n";
        echo "Komutlar:\n";
        echo "  migrate              Tüm bekleyen migration'ları çalıştır\n";
        echo "  migrate:rollback     Son batch'i rollback et\n";
        echo "  migrate:status       Migration durumunu göster\n";
        echo "  migrate:create <ad>  Yeni migration oluştur\n";
        echo "  seed [class]         Seed verilerini yükle\n";
        echo "  seed:create <ad>     Yeni seeder oluştur\n";
        echo "  db:status            Veritabanı durumunu göster\n";
        echo "  schema:check         Şema tanımını canlı veritabanıyla karşılaştır (fark varsa çıkış kodu 1)\n";
        echo "  help                 Bu yardım mesajını göster\n\n";
        echo "Seçenekler:\n";
        echo "  --path=<dizin>        Migration dizini (varsayılan: MIGRATIONS_PATH veya database/migrations)\n";
        echo "  --seeds-path=<dizin>  Seed dizini (varsayılan: SEEDS_PATH veya database/seeds)\n";
        echo "  --schema=<dosya>      Şema dosyası (varsayılan: SCHEMA_PATH veya database/schema.php)\n";
        echo "  --strict              schema:check: şemada olmayan kolonlar da hata sayılır\n";
        echo "  --json                schema:check: raporu JSON olarak yaz\n";
    }

    private function error(string $message): void
    {
        fwrite(STDERR, "HATA: {$message}\n");
        exit(1);
    }
}

// CLI'yi çalıştır
$cli = new nsql_cli();
$cli->run($argv);
