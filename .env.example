# nsql — örnek ortam yapılandırması
# Kullanım: cp .env.example .env
#
# config::get('db_host') gibi çağrılar büyük harfe çevrilir (DB_HOST).
# Pool için DB_MIN_CONNECTIONS ve MIN_CONNECTIONS eşdeğerdir (bkz. config aliases).

# Proje kökü (opsiyonel): .env'in bulunduğu dizin; belirtilmezse otomatik aranır
# NSQL_PROJECT_ROOT=/path/to/your/app

# Ortam: production | development | testing
ENV=development

# Veritabanı — new nsql() varsayılan olarak bu değerleri kullanır
DB_HOST=localhost
DB_PORT=3306
DB_NAME=database_name
DB_USER=database_user
DB_PASS=database_password
DB_CHARSET=utf8mb4
DB_DRIVER=mysql

# PDO seçenekleri
CONNECTION_TIMEOUT=5
PERSISTENT_CONNECTION=false

# Connection pool (DB_* veya MIN_CONNECTIONS / MAX_CONNECTIONS)
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
DB_HEALTH_CHECK_INTERVAL=60
DB_CONNECTION_TIMEOUT=30
DB_CONNECTION_IDLE_TIMEOUT=600
DB_READ_WRITE_SPLIT=false
DB_POOL_LOG_FILE=pool_log.txt

# Önbellek
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TIMEOUT=300
QUERY_CACHE_SIZE_LIMIT=1000
STATEMENT_CACHE_LIMIT=100

# Debug / log
DEBUG_MODE=false
LOG_FILE=error_log.txt
AUDIT_LOG_FILE=audit_log.txt
LOG_DIR=storage/logs
LOG_MAX_SIZE=1048576

# Performans
LARGE_RESULT_WARNING=10000
MAX_RESULT_SET_SIZE=1000000
MEMORY_CHECK_INTERVAL=30
MEMORY_LIMIT_WARNING=134217728
MEMORY_LIMIT_CRITICAL=268435456
AUTO_ADJUST_CHUNK_SIZE=true
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=10000

# Güvenlik
SECURITY_STRICT_MODE=false
# ENCRYPTION_KEY=  # php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# RATE_LIMIT_ENABLED=true

# Monitoring (public/health.php, public/metrics.php)
# NSQL_MONITORING_TOKEN=change-me-to-a-long-random-secret
# NSQL_MONITORING_ENABLED=true
