# nsql — örnek ortam yapılandırması
# Kullanım: cp .env.example .env
#
# config::get('db_host') büyük harfe çevrilir (DB_HOST).
# Pool: DB_MIN_CONNECTIONS ≡ MIN_CONNECTIONS (config aliases).
#
# Varsayılanlar config::default_values() / class constant'lardan gelir (#27):
#   MIN_CONNECTIONS=2  MAX_CONNECTIONS=15  HEALTH_CHECK_INTERVAL=60
#   CONNECTION_IDLE_TIMEOUT=600  CONNECTION_TIMEOUT=5
#   QUERY_CACHE_TIMEOUT=1800  STATEMENT_CACHE_LIMIT=150
#   MIN_CHUNK_SIZE=200  MAX_CHUNK_SIZE=15000

# Proje kökü (opsiyonel)
# NSQL_PROJECT_ROOT=/path/to/your/app

# Ortam: production | development | testing
ENV=development

# Veritabanı
DB_HOST=localhost
DB_PORT=3306
DB_NAME=database_name
DB_USER=database_user
DB_PASS=database_password
DB_CHARSET=utf8mb4
DB_DRIVER=mysql

# PDO
CONNECTION_TIMEOUT=5
PERSISTENT_CONNECTION=false

# Connection pool (değerler kütüphane default'ları ile aynı)
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=15
DB_HEALTH_CHECK_INTERVAL=60
DB_CONNECTION_IDLE_TIMEOUT=600
DB_READ_WRITE_SPLIT=false
DB_POOL_LOG_FILE=pool_log.txt

# Önbellek
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TIMEOUT=1800
QUERY_CACHE_SIZE_LIMIT=200
STATEMENT_CACHE_LIMIT=150

# Debug / log
DEBUG_MODE=false
LOG_FILE=error_log.txt
AUDIT_LOG_FILE=audit_log.txt
LOG_DIR=storage/logs
LOG_MAX_SIZE=1048576

# Performans
LARGE_RESULT_WARNING=15000
MAX_RESULT_SET_SIZE=2000000
MEMORY_CHECK_INTERVAL=60
MEMORY_LIMIT_WARNING=201326592
MEMORY_LIMIT_CRITICAL=402653184
AUTO_ADJUST_CHUNK_SIZE=true
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=15000

# Güvenlik
SECURITY_STRICT_MODE=false
# ENCRYPTION_KEY=
# RATE_LIMIT_ENABLED=true

# Monitoring
# NSQL_MONITORING_TOKEN=change-me-to-a-long-random-secret
# NSQL_MONITORING_ENABLED=true
