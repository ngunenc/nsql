includes:
    - phpstan-baseline.neon

# Tek kaynak: seviye yalnızca burada tanımlanır. `composer stan` ve CI bu dosyayı kullanır;
# komut satırında --level verilmez.
parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - src/database/migrations
        - src/database/templates
    ignoreErrors:
        - identifier: missingType.iterableValue
    reportUnmatchedIgnoredErrors: true
    treatPhpDocTypesAsCertain: false
    parallel:
        jobSize: 5
        maximumNumberOfProcesses: 1
