# Test ortamı (.env.testing) — phpunit / test:setup
ENV=testing

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nsql_test_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_DRIVER=mysql

CONNECTION_TIMEOUT=5
PERSISTENT_CONNECTION=false

DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=5
DB_HEALTH_CHECK_INTERVAL=60
DB_CONNECTION_TIMEOUT=30

QUERY_CACHE_ENABLED=false
QUERY_CACHE_TIMEOUT=60
QUERY_CACHE_SIZE_LIMIT=100
STATEMENT_CACHE_LIMIT=50

DEBUG_MODE=false
LOG_FILE=test_error_log.txt
SECURITY_STRICT_MODE=false
