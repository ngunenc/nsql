{
	"name": "ngunenc/nsql",
	"description": "Modern PHP PDO veritabanı kütüphanesi (nsql) v2.2.1",
	"version": "2.2.1",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "nsql contributors"
		}
	],
	"require": {
		"php": ">=8.1",
		"psr/log": "^1.1 || ^2.0 || ^3.0",
		"psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
	},
	"autoload": {
		"psr-4": {
			"nsql\\": "src/"
		},
		"files": [
			"src/legacy_autoload.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		},
		"classmap": [
			"tests/Fixtures/Migrations"
		]
	},
	"bin": [
		"bin/nsql"
	],
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.9",
		"phpstan/phpstan": "^2.1",
		"friendsofphp/php-cs-fixer": "^3.0"
	},
	"scripts": {
		"test": "phpunit -c phpunit.xml || phpunit",
		"test:cache": [
			"@putenv NSQL_TEST_QUERY_CACHE=1",
			"@php vendor/bin/phpunit -c phpunit.xml --testsuite integration,portable"
		],
		"test:coverage-check": "@php tests/coverage_check.php coverage/clover.xml 50 --lowest=10",
		"test:portable": "@php vendor/bin/phpunit -c phpunit.xml --testsuite portable",
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"@php vendor/bin/phpunit -c phpunit.xml --coverage-clover coverage/clover.xml --coverage-text"
		],
		"test:setup": "php tests/setup_test_db.php",
		"test:cleanup": "php tests/cleanup_test_db.php",
		"test:full": [
			"@test:setup",
			"@test",
			"@test:cleanup"
		],
		"lint": "phpcs",
		"stan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
		"stan:baseline": "phpstan analyse -c phpstan.neon --memory-limit=1G --generate-baseline phpstan-baseline.neon",
		"fix": "php-cs-fixer fix --config=.php-cs-fixer.php"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	},
	"archive": {
		"exclude": [
			"/tests",
			"/benchmarks",
			"/docs",
			"/.github",
			"/phpunit.xml",
			"/.phpunit.cache",
			"/phpstan.neon",
			"/phpstan-baseline.neon",
			"/phpcs.xml.dist",
			"/.php-cs-fixer.php",
			"/.php-cs-fixer.cache",
			"/README.md",
			"/CHANGELOG.md",
			"/CONTRIBUTING.md",
			"/examples",
			"/.cursor",
			"/env.example",
			"/.env.example",
			"/.env.testing",
			"/Dockerfile",
			"/docker-compose.yml",
			"/docker-compose.dev.yml",
			"/docker",
			"/scripts",
			"/storage"
		]
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
